# Forecast & Optimization Module Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# DAC Service Configuration
# =============================================================================

# URL of the Data Access and Control (DAC) module REST API
# In production, this should point to the deployed DAC service
FORECAST_DAC_BASE_URL=http://localhost:8001/api/v1

# Set to "true" ONLY for local development without DAC module running
# In production, this MUST be "false" to use real database data
FORECAST_USE_MOCK_DAC=false

# HTTP request timeout in seconds for DAC API calls
FORECAST_DAC_TIMEOUT_SECONDS=30.0
